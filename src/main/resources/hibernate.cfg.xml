<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>

        <property name="connection.driver_class">com.p6spy.engine.spy.P6SpyDriver</property>
        <property name="connection.url">jdbc:p6spy:mysql://localhost:3306/world</property>
        <property name="connection.username">root</property>
        <property name="connection.password">root</property>


        <property name="dialect">org.hibernate.dialect.MySQLDialect</property>

        <property name="show_sql">true</property>
        <property name="format_sql">true</property>

        <mapping class="org.example.domain.City"/>
        <mapping class="org.example.domain.Country"/>
        <mapping class="org.example.domain.CountryLanguage"/>

    </session-factory>
</hibernate-configuration>
